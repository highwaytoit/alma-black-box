# Alma Black Box supplied Quadlet template.
# Follows the upstream Cockpit ws latest tag.
# Recommended: copy this file into /etc/containers/systemd/ and customize the local copy.
# Symlinking the supplied template is possible but not recommended; see docs/QUADLETS.md.

[Unit]
Description=Cockpit web console for Alma Black Box
Wants=network-online.target
After=network-online.target sshd.service

[Container]
Image=@@COCKPIT_WS_IMAGE@@
ContainerName=cockpit-ws
Volume=/:/host
Environment=NAME=cockpit-ws
Environment=IMAGE=@@COCKPIT_WS_IMAGE@@
Exec=/container/label-run
PodmanArgs=--privileged --pid=host

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
