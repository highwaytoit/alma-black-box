# Alma Black Box v1 software declaration.
#
# Keep host-native software focused on physical-host administration,
# networking, power/UPS integration, diagnostics, and the Cockpit bridge.
# Replaceable monitoring applications belong in Quadlets instead.

ALMA_BLACK_BOX_PACKAGES="\
NetworkManager \
firewalld \
openssh-server \
 nut \
 nut-client \
 wireguard-tools \
 fwupd \
 smartmontools \
 lm_sensors \
 nvme-cli \
 usbutils \
 pciutils \
 ethtool \
 powertop \
 btop \
 micro \
 tmux \
 jq \
 rsync \
 tcpdump \
 bind-utils \
 traceroute \
 nmap-ncat \
 iperf3 \
 policycoreutils-python-utils \
 selinux-policy-extra \
 cockpit-system \
 cockpit-podman \
 cockpit-storaged"

TAILSCALE_PACKAGE="tailscale"
NETBIRD_PACKAGE="netbird"

# Cockpit web service stays containerized. Native cockpit-system/bridge pages
# are installed so the ws container can administer the local host and load
# host-installed extensions such as UPSide.
COCKPIT_WS_IMAGE="quay.io/cockpit/ws:366"

# renovate: datasource=github-tags packageName=deviationist/cockpit-upside versioning=semver
UPSIDE_VERSION="1.0.6"
UPSIDE_COMMIT="0761c8cc5aa566feec05d722c220ecd5f40bb9a3"
